<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DeepProtocolLocalCutover)' == 'true'">
    <DefineConstants>$(DefineConstants);DEEP_PROTOCOL_DIRECTORY_V1</DefineConstants>
    <AssemblyName>Deep.Protocol.Tests</AssemblyName>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(BaseIntermediateOutputPath)source-cutover\packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DirectoryCompactionTestSeam)' == 'true'">
    <DefineConstants>$(DefineConstants);DEEP_DIRECTORY_COMPACTION_TEST_SEAM</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(DeepProtocolLocalCutover)' != 'true'">
    <PackageReference Include="Deep.Protocol" Version="[0.5.0-production.e75bfed]" />
    <PackageReference Include="Deep.Protocol.MembershipRoutes" Version="[0.5.0-production.e75bfed]" />
  </ItemGroup>

  <ItemGroup Condition="'$(DeepProtocolLocalCutover)' == 'true'">
    <ProjectReference Include="..\..\..\deep-protocol\src\Deep.Protocol\Deep.Protocol.csproj"
                      AdditionalProperties="RecoveryTestSeam=true" />
    <ProjectReference Include="..\..\..\deep-protocol\src\Deep.Protocol.MembershipRoutes\Deep.Protocol.MembershipRoutes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Deep.Registry.Api\Deep.Registry.Api.csproj" />
    <ProjectReference Include="..\..\..\deep-client-shared\src\Deep.Client.Shared\Deep.Client.Shared.Production.csproj"
                      AdditionalProperties="EnableDeepTestInternals=true"
                      Condition="'$(DeepProtocolLocalCutover)' == 'true' and '$(MailboxSignerFocused)' != 'true' and '$(DirectoryDiagnosticsFocused)' != 'true'" />
    <ProjectReference Include="..\..\..\xnode\src\XNode.Core\XNode.Core.csproj"
                      Condition="'$(DirectoryVerifierFocused)' != 'true'" />
    <ProjectReference Include="..\..\..\xnode\src\XNode.Registry\XNode.Registry.csproj"
                      Condition="'$(DirectoryVerifierFocused)' != 'true'" />
    <ProjectReference Include="..\..\..\xnode\src\XNode\XNode.csproj"
                      Condition="'$(DirectoryVerifierFocused)' != 'true'"
                      Aliases="xnode" />
  </ItemGroup>

  <ItemGroup Condition="'$(DirectoryVerifierFocused)' == 'true'">
    <Compile Remove="PrivacyContactXNodeContractTests.cs" />
    <Compile Remove="ProductionMailboxCoordinatorTests.cs" />
    <Compile Remove="ProductionMailboxV2PublicationTests.cs" />
    <Compile Remove="ProductionMailboxV2XNodeContractTests.cs" />
  </ItemGroup>

  <!-- Fast business-slice lane only; the default full gate remains unchanged. -->
  <ItemGroup Condition="'$(NetworkDistributionFocused)' == 'true'">
    <Compile Remove="**\*.cs" />
    <Compile Include="XPointNetworkClosureDistributionHostingTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RouteThresholdFocused)' == 'true'">
    <Compile Remove="**\*.cs" />
    <Compile Include="ContactRouteAuthorityHttpTests.cs" />
    <Compile Include="ContactRouteClosureTransportTests.cs" />
    <Compile Include="DeepIdV2RouteThresholdJournalTests.cs" />
    <Compile Include="DeepIdV2RouteThresholdIssuerTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(DirectoryDiagnosticsFocused)' == 'true'">
    <Compile Remove="**\*.cs" />
    <Compile Include="DirectoryPublicationDiagnosticsTests.cs" />
    <Compile Include="DirectorySourceCutoverTests.cs" />
    <Compile Include="DirectoryNetworkAuthorityFixture.cs" />
    <Compile Include="BoundedRequestAdmissionGateTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(MailboxGrantFocused)' == 'true'">
    <Compile Remove="**\*.cs" />
    <Compile Include="DeepIdV2MailboxGrantHttpTests.cs" />
    <Compile Include="DeepIdV2MailboxGrantJournalTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TrustedTimeUpgradeFocused)' == 'true'">
    <Compile Remove="**\*.cs" />
    <Compile Include="AutomaticNtsTrustedTimeSourceTests.cs" />
    <Compile Include="ProductionContactResolveDirectoryPackageIssuerTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(MailboxSignerFocused)' == 'true'">
    <Compile Remove="**\*.cs" />
    <Compile Include="UnixSocketEd25519ExternalSignerTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\sql\did2-publication-journal.sql"
          Link="Fixtures\did2-publication-journal.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\sql\did2-mailbox-grant-journal.sql"
          Link="Fixtures\did2-mailbox-grant-journal.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\sql\did2-route-threshold-journal.sql"
          Link="Fixtures\did2-route-threshold-journal.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\sql\did2-route-threshold-issued-head-upgrade.sql"
          Link="Fixtures\did2-route-threshold-issued-head-upgrade.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\sql\did2-latest-head-floor.sql"
          Link="Fixtures\did2-latest-head-floor.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\vendor\p04\membership-contract-v1.json"
          Link="Fixtures\membership-contract-v1.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\did2-genesis.dga1v2"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
